# ═══════════════════════════════════════════════════════════════════════════════
# 🙈 .gitignore - Marketplace CS Dashboard
# Menjaga repository GitHub tetap bersih dan hanya berisi kode sumber penting.
# ═══════════════════════════════════════════════════════════════════════════════

# 📦 Dependencies
node_modules/
.pnp
.pnp.js

# 🏗️ Production & Build Outputs (Electron Builder & Packager)
dist/
build/
out/
release/
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.zip
*.tar.gz
*.blockmap
latest*.yml

# 🔑 Environment, Credentials & Local Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.pfx
*.p12

# 🧪 Test, E2E & Coverage Artifacts (Playwright, NYC, Coverage)
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# 🌐 Electron Runtime, Webview Partitions & Cache Dumps
Session Storage/
Local Storage/
IndexedDB/
GPUCache/
Code Cache/
DawnCache/
blob_storage/
Service Worker/
Partitions/
crash-dumps/
minidumps/
*.dmp
user-data/
userData/
local-data/
temp/
tmp/
downloads/

# 📜 Logs & Debug Dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 💻 OS-Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# 🛠️ IDE, Editor & Workspace Caches
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.code-workspace
.history/
.eslintcache
.tsbuildinfo

# 🗄️ Temporary, Scratchpad & Backup Files
*.tmp
*.bak
*.backup
*.old
*.crswap

# 🔒 Backend / Private Automation Scripts
scripts/google-apps-script/
