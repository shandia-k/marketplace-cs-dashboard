{
  "name": "marketplace-cs-dashboard",
  "version": "1.0.14",
  "description": "Dashboard CS Multi-Marketplace - Kelola semua akun chat marketplace dalam 1 jendela",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/anti-regression-guard.js && electron .",
    "test": "node tests/run-all-tests.js",
    "test:unit": "node tests/run-all-tests.js --unit",
    "test:security": "node tests/run-all-tests.js --security",
    "test:storage": "node tests/run-all-tests.js --storage",
    "test:ipc": "node tests/run-all-tests.js --ipc",
    "test:renderer": "node tests/run-all-tests.js --renderer",
    "test:webview": "node tests/run-all-tests.js --webview",
    "test:regression": "node tests/run-all-tests.js --regression",
    "test:smoke": "node tests/run-all-tests.js --smoke",
    "test:e2e": "playwright test",
    "test:all": "node tests/run-all-tests.js && playwright test",
    "guard": "node scripts/anti-regression-guard.js",
    "validate": "node scripts/validate-version.js",
    "build": "node scripts/anti-regression-guard.js && electron-builder --win --x64"
  },
  "keywords": [
    "marketplace",
    "shopee",
    "tokopedia",
    "lazada",
    "cs",
    "dashboard"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.cs.marketplace-dashboard",
    "productName": "CS Marketplace Dashboard",
    "publish": [
      {
        "provider": "github",
        "owner": "shandia-k",
        "repo": "marketplace-cs-dashboard",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "mammoth": "^1.12.0",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  }
}